---
import "~/styles/global.css";
import Nav from "~/components/Nav.astro";
import Footer from "~/components/Footer.astro";
import ScrollProgress from "~/components/ScrollProgress.astro";
import BackToTop from "~/components/BackToTop.astro";
import bricolageFont from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url";
import jetbrainsFont from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";
import unboundedFont from "@fontsource-variable/unbounded/files/unbounded-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  showFooter?: boolean;
}
const SITE_NAME = "Dethanev 開發室";
const DEFAULT_TITLE = "Dethanev 開發室";
const DEFAULT_DESCRIPTION = "Dethanev 開發室是個人網站與開發筆記，記錄 App、Web、Server、Side Project 與自架系統實作。";
const DEFAULT_OG_IMAGE_ALT = "Dethanev 開發室 — App / Web / Server";
const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  ogImage = "/og-default.png",
  showFooter = true,
} = Astro.props;
const fullTitle = title === DEFAULT_TITLE ? title : `${title} — ${SITE_NAME}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const ogImageURL = new URL(ogImage, Astro.site ?? Astro.url.origin);
const personId = new URL("/#person", Astro.site ?? Astro.url.origin).toString();
const websiteId = new URL("/#website", Astro.site ?? Astro.url.origin).toString();
const webpageId = `${canonicalURL.toString()}#webpage`;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: "Dethanev",
      url: new URL("/", Astro.site ?? Astro.url.origin).toString(),
      sameAs: [
        "https://github.com/Dethanev",
        "https://wakatime.com/@Dethanev"
      ],
      knowsAbout: [
        "Flutter",
        "FastAPI",
        "Docker",
        "Supabase",
        "PostgreSQL",
        "Proxmox",
        "Cloudflare Tunnel",
        "Prometheus",
        "Grafana",
        "Astro",
        "Web development",
        "App development",
        "Backend development"
      ],
      jobTitle: "Software Developer",
      description: "Dethanev 專注 App、Web、後端服務、自架系統與資料驅動應用。"
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      name: SITE_NAME,
      alternateName: ["Dethanev", "Dethanev Blog", "Dethanev 開發室"],
      url: new URL("/", Astro.site ?? Astro.url.origin).toString(),
      inLanguage: "zh-Hant-TW",
      publisher: { "@id": personId },
      author: { "@id": personId }
    },
    {
      "@type": "WebPage",
      "@id": webpageId,
      url: canonicalURL.toString(),
      name: fullTitle,
      description,
      isPartOf: { "@id": websiteId },
      author: { "@id": personId },
      publisher: { "@id": personId },
      inLanguage: "zh-Hant-TW"
    }
  ]
};
const fontFaceCSS = `
  @font-face {
    font-family: "Unbounded Variable";
    font-style: normal;
    font-display: swap;
    font-weight: 200 900;
    src: url("${unboundedFont}") format("woff2-variations");
  }
  @font-face {
    font-family: "Bricolage Grotesque Variable";
    font-style: normal;
    font-display: swap;
    font-weight: 200 800;
    src: url("${bricolageFont}") format("woff2-variations");
  }
  @font-face {
    font-family: "JetBrains Mono Variable";
    font-style: normal;
    font-display: swap;
    font-weight: 100 800;
    src: url("${jetbrainsFont}") format("woff2-variations");
  }
`;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fff7e6" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="preload" href={unboundedFont} as="font" type="font/woff2" crossorigin media="(min-width: 721px)" />
    <style is:inline set:html={fontFaceCSS}></style>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Dethanev" />
    <meta name="keywords" content="Dethanev, Dethanev 開發室, 個人網站, 作品集, 開發筆記, App 開發, Web 開發, 後端服務, Flutter, FastAPI, Astro" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={DEFAULT_OG_IMAGE_ALT} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_TW" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={DEFAULT_OG_IMAGE_ALT} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var t = "light";
        try {
          var stored = localStorage.getItem("theme");
          if (stored === "light" || stored === "dark") t = stored;
        } catch (e) {}
        root.classList.toggle("dark", t === "dark");
        root.dataset.theme = t;
        root.style.colorScheme = t;
        var themeColor = document.querySelector('meta[name="theme-color"]');
        if (themeColor) themeColor.setAttribute("content", t === "dark" ? "#0e0e14" : "#fff7e6");
      })();
    </script>
  </head>
  <body>
    <ScrollProgress />
    <Nav />
    <main>
      <slot />
    </main>
    {showFooter && <Footer />}
    <BackToTop />

    <script>
      function runInit(fn: () => void) {
        try {
          fn();
        } catch (error) {
          console.error("[site:init]", error);
        }
      }

      async function bootCore() {
        const { initInteractions } = await import("~/scripts/interactions");
        runInit(initInteractions);
      }

      async function bootMotion() {
        const [{ initLenis }, { initScrollAnimations }] = await Promise.all([
          import("~/scripts/lenis"),
          import("~/scripts/scroll-anims"),
        ]);
        runInit(initLenis);
        runInit(initScrollAnimations);
      }

      function scheduleCoreBoot() {
        if ("requestIdleCallback" in window) {
          window.requestIdleCallback(() => void bootCore(), { timeout: 1200 });
        } else {
          setTimeout(() => void bootCore(), 1);
        }
      }

      let motionBooted = false;
      let motionTimer: number | undefined;
      function scheduleMotionBoot() {
        if (motionBooted) return;

        const bootOnce = () => {
          if (motionBooted) return;
          motionBooted = true;
          if (motionTimer !== undefined) window.clearTimeout(motionTimer);
          window.removeEventListener("scroll", bootOnce);
          window.removeEventListener("wheel", bootOnce);
          window.removeEventListener("touchstart", bootOnce);
          window.removeEventListener("keydown", bootOnce);
          void bootMotion();
        };

        window.addEventListener("scroll", bootOnce, { once: true, passive: true });
        window.addEventListener("wheel", bootOnce, { once: true, passive: true });
        window.addEventListener("touchstart", bootOnce, { once: true, passive: true });
        window.addEventListener("keydown", bootOnce, { once: true });
        motionTimer = window.setTimeout(bootOnce, 12000);
      }

      if (document.readyState === "complete") {
        scheduleCoreBoot();
        scheduleMotionBoot();
      } else {
        window.addEventListener("load", () => {
          scheduleCoreBoot();
          scheduleMotionBoot();
        }, { once: true });
      }
    </script>
  </body>
</html>
