---
import "~/styles/global.css";
import Nav from "~/components/Nav.astro";
import Footer from "~/components/Footer.astro";
import ScrollProgress from "~/components/ScrollProgress.astro";
import BackToTop from "~/components/BackToTop.astro";
import { ClientRouter } from "astro:transitions";
import bricolageFont from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url";
import jetbrainsFont from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";
import unboundedFont from "@fontsource-variable/unbounded/files/unbounded-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  showFooter?: boolean;
}
const SITE_NAME = "Dethanev 開發室";
const DEFAULT_TITLE = "Dethanev 開發室";
const DEFAULT_DESCRIPTION = "這裡是 Dethanev 的開發室，記錄把想法做成 App、Web 與後端服務的過程，也分享 side project、開發中遇到的問題、解法與一些生活碎念。";
const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  ogImage = "/og-default.png",
  showFooter = true,
} = Astro.props;
const fullTitle = title === DEFAULT_TITLE ? title : `${title} — ${SITE_NAME}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const fontFaceCSS = `
  @font-face {
    font-family: "Unbounded Variable";
    font-style: normal;
    font-display: optional;
    font-weight: 200 900;
    src: url("${unboundedFont}") format("woff2-variations");
  }
  @font-face {
    font-family: "Bricolage Grotesque Variable";
    font-style: normal;
    font-display: optional;
    font-weight: 200 800;
    src: url("${bricolageFont}") format("woff2-variations");
  }
  @font-face {
    font-family: "JetBrains Mono Variable";
    font-style: normal;
    font-display: optional;
    font-weight: 100 800;
    src: url("${jetbrainsFont}") format("woff2-variations");
  }
`;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fff7e6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="preload" href={bricolageFont} as="font" type="font/woff2" crossorigin media="(min-width: 721px)" />
    <link rel="preload" href={jetbrainsFont} as="font" type="font/woff2" crossorigin media="(min-width: 721px)" />
    <link rel="preload" href={unboundedFont} as="font" type="font/woff2" crossorigin media="(min-width: 721px)" />
    <style is:inline set:html={fontFaceCSS}></style>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <ClientRouter />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme") || "light";
          if (t === "dark") document.documentElement.classList.add("dark");
          document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <ScrollProgress />
    <Nav />
    <main>
      <slot />
    </main>
    {showFooter && <Footer />}
    <BackToTop />

    <script>
      function runInit(fn: () => void) {
        try {
          fn();
        } catch (error) {
          console.error("[site:init]", error);
        }
      }

      async function boot() {
        const [{ initInteractions }, { initLenis }, { initScrollAnimations }] = await Promise.all([
          import("~/scripts/interactions"),
          import("~/scripts/lenis"),
          import("~/scripts/scroll-anims"),
        ]);
        runInit(initInteractions);
        runInit(initLenis);
        runInit(initScrollAnimations);
      }

      function scheduleBoot() {
        if ("requestIdleCallback" in window) {
          window.requestIdleCallback(() => void boot(), { timeout: 1500 });
        } else {
          window.setTimeout(() => void boot(), 1);
        }
      }

      if (document.readyState === "complete") {
        scheduleBoot();
      } else {
        window.addEventListener("load", scheduleBoot, { once: true });
      }

      document.addEventListener("astro:after-swap", scheduleBoot);
    </script>
  </body>
</html>
