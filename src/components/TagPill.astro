---
interface Props {
  tag: string;
  href?: string;
  class?: string;
}
const { tag, href, class: cls = "" } = Astro.props;
const Tag = href ? "a" : "span";
---

<Tag href={href} class:list={["tag-pill brutal-border-thick", cls]}>
  #{tag}
</Tag>

<style>
  .tag-pill {
    display: inline-block;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.8rem;
    padding: 0.2em 0.7em;
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
    transition: transform 0.15s ease, background 0.15s ease;
    line-height: 1.4;
  }
  a.tag-pill:hover {
    background: var(--accent-yellow);
    color: var(--text-on-yellow);
    border-color: var(--ink);
    transform: translate(-1px, -1px);
  }
</style>
