---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  quality?: number;
}

const { src, alt, caption, quality = 85 } = Astro.props;
---

<figure class="project-showcase">
  <Image
    src={src}
    alt={alt}
    widths={[640, 960, 1400]}
    sizes="(max-width: 760px) 100vw, 700px"
    format="webp"
    quality={quality}
    loading="lazy"
  />
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .project-showcase {
    margin: 2.2em 0 3em;
    padding: 0.7rem;
    border: 4px solid var(--ink);
    background: var(--paper);
    box-shadow: var(--shadow);
    transform: rotate(0.25deg);
  }

  .project-showcase :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 3px solid var(--ink);
  }

  figcaption {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0.75rem 0.2rem 0.1rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  figcaption::before {
    content: "";
    width: 0.75rem;
    height: 0.75rem;
    flex: 0 0 auto;
    border: 2px solid var(--ink);
    background: var(--accent-yellow);
    transform: rotate(-5deg);
  }

  @media (max-width: 520px) {
    .project-showcase {
      margin-block: 1.8em 2.5em;
      padding: 0.45rem;
      box-shadow: var(--shadow-sm);
      transform: none;
    }

    figcaption {
      margin: 0.6rem 0.15rem 0.05rem;
      font-size: 0.72rem;
    }
  }
</style>
