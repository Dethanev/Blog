---

<button
  class="back-to-top"
  type="button"
  aria-label="回到頁面頂端"
  title="回到頂部"
  data-back-to-top
>
  <span class="label">BACK TO TOP</span>
  <span class="arrow" aria-hidden="true">↑</span>
</button>

<style>
  .back-to-top {
    position: fixed;
    right: max(0.75rem, calc((100vw - 1200px) / 2 - 3rem));
    top: 50%;
    z-index: 50;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    width: 2rem;
    padding: 0.5rem 0;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-weight: 700;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translate(1rem, -50%);
    transition:
      opacity 0.2s ease,
      visibility 0.2s ease,
      color 0.15s ease,
      transform 0.2s ease;
  }

  .back-to-top::before {
    position: absolute;
    inset-block: 0.25rem;
    left: 50%;
    z-index: -1;
    width: 1.2rem;
    border-radius: 999px;
    background: #f8849c;
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 28%),
      0 2px 10px rgb(10 10 15 / 8%);
    backdrop-filter: blur(10px) saturate(140%);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    content: "";
    opacity: 0.62;
    transform: translateX(-50%);
    transition: opacity 0.15s ease, box-shadow 0.15s ease;
  }

  .back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translate(0, -50%);
  }

  .back-to-top:hover {
    transform: translate(-4px, -50%);
  }

  .back-to-top:hover::before {
    opacity: 0.76;
  }

  .back-to-top:active {
    transform: translate(0, -50%) scale(0.94);
  }

  .back-to-top:focus-visible {
    outline: 2px dashed var(--accent-1);
    outline-offset: 4px;
  }

  .arrow {
    display: grid;
    place-items: center;
    font-size: 1.25rem;
    line-height: 1;
  }

  .label {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    white-space: nowrap;
  }

  @media (min-width: 721px) {
    .back-to-top {
      right: 0.35rem;
      width: 3rem;
      gap: 1.4rem;
      padding: 1rem 0;
      color: var(--ink);
    }

    .back-to-top::before {
      display: none;
    }

    .back-to-top:hover {
      color: var(--accent-1);
    }

    .label {
      font-size: 0.82rem;
      letter-spacing: 0.32em;
    }

    .arrow {
      font-size: 1.75rem;
    }
  }

  @media (max-width: 720px) {
    .back-to-top {
      --scroll-progress: 0;

      right: 1rem;
      top: auto;
      bottom: max(1rem, env(safe-area-inset-bottom));
      width: 3.25rem;
      height: 3.25rem;
      padding: 0;
      border: 3px solid var(--ink);
      border-radius: 50%;
      background: conic-gradient(
        var(--accent-1) calc(var(--scroll-progress) * 1turn),
        color-mix(in oklab, var(--ink) 16%, var(--paper)) 0
      );
      box-shadow: 4px 4px 0 var(--ink);
      color: var(--ink);
      transform: translateY(1rem) scale(0.9);
    }

    .back-to-top::before {
      inset: 5px;
      left: 5px;
      z-index: 0;
      width: auto;
      border-radius: 50%;
      background: var(--paper);
      box-shadow: none;
      opacity: 1;
      transform: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .back-to-top.is-visible {
      transform: translateY(0) scale(1);
    }

    .back-to-top:hover,
    .back-to-top:active {
      transform: translateY(0) scale(1);
    }

    .back-to-top:active {
      box-shadow: 1px 1px 0 var(--ink);
      translate: 3px 3px;
    }

    .arrow {
      position: relative;
      z-index: 1;
      font-size: 1.35rem;
    }

    .back-to-top.is-jumping .arrow {
      animation: jump-to-top 0.45s ease-out;
    }

    .label {
      display: none;
    }

    :global(.dark) .back-to-top {
      box-shadow: 4px 4px 0 var(--accent-2);
    }
  }

  @keyframes jump-to-top {
    0% { transform: translateY(0); opacity: 1; }
    45% { transform: translateY(-0.75rem); opacity: 0; }
    46% { transform: translateY(0.65rem); opacity: 0; }
    100% { transform: translateY(0); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: none;
    }

    .back-to-top.is-jumping .arrow {
      animation: none;
    }
  }
</style>
