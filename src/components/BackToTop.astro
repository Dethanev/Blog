<button
  class="back-to-top"
  type="button"
  aria-label="回到頁面頂端"
  title="回到頂部"
  data-back-to-top
>
  <span class="label">BACK TO TOP</span>
  <span class="arrow" aria-hidden="true">↑</span>
</button>

<style>
  .back-to-top {
    position: fixed;
    right: max(0.75rem, calc((100vw - 1200px) / 2 - 3rem));
    top: 50%;
    z-index: 50;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    width: 2rem;
    padding: 0.5rem 0;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-weight: 700;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translate(1rem, -50%);
    transition:
      opacity 0.2s ease,
      visibility 0.2s ease,
      color 0.15s ease,
      transform 0.2s ease;
  }

  .back-to-top::before {
    position: absolute;
    inset-block: 0.25rem;
    left: 50%;
    z-index: -1;
    width: 1.2rem;
    border-radius: 999px;
    background: #f8849c;
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 28%),
      0 2px 10px rgb(10 10 15 / 8%);
    backdrop-filter: blur(10px) saturate(140%);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    content: "";
    opacity: 0.62;
    transform: translateX(-50%);
    transition: opacity 0.15s ease, box-shadow 0.15s ease;
  }

  .back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translate(0, -50%);
  }

  .back-to-top:hover {
    transform: translate(-4px, -50%);
  }

  .back-to-top:hover::before {
    opacity: 0.76;
  }

  .back-to-top:active {
    transform: translate(0, -50%) scale(0.94);
  }

  .back-to-top:focus-visible {
    outline: 2px dashed var(--accent-1);
    outline-offset: 4px;
  }

  .arrow {
    display: grid;
    place-items: center;
    font-size: 1.25rem;
    line-height: 1;
  }

  .label {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    white-space: nowrap;
  }

  @media (min-width: 721px) {
    .back-to-top {
      right: 0.35rem;
      width: 3rem;
      gap: 1.4rem;
      padding: 1rem 0;
      color: var(--ink);
    }

    .back-to-top::before {
      display: none;
    }

    .back-to-top:hover {
      color: var(--accent-1);
    }

    .label {
      font-size: 0.82rem;
      letter-spacing: 0.32em;
    }

    .arrow {
      font-size: 1.75rem;
    }
  }

  @media (max-width: 720px) {
    .back-to-top {
      right: -0.4rem;
    }
  }

  @media (max-width: 480px) {
    .label {
      font-size: 0.6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: none;
    }
  }
</style>
