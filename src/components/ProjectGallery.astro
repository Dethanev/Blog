---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface GalleryItem {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  items: GalleryItem[];
  caption: string;
}

const { items, caption } = Astro.props;
---

<figure class="project-gallery">
  <div class="gallery-grid">
    {items.map((item) => (
      <div class="gallery-item">
        <Image
          src={item.src}
          alt={item.alt}
          widths={[360, 640, 960]}
          sizes="(max-width: 620px) 176px, 165px"
          format="webp"
          quality={85}
          loading="lazy"
        />
      </div>
    ))}
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .project-gallery {
    margin: 2.2em 0 3em;
    padding: 0.8rem;
    border: 4px solid var(--ink);
    background: var(--paper);
    box-shadow: var(--shadow);
    transform: rotate(0.2deg);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.55rem;
  }

  .gallery-item {
    position: relative;
    overflow: hidden;
    border: 3px solid var(--ink);
    background: var(--bg);
  }

  .gallery-item :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0.75rem 0.2rem 0.1rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  figcaption::before {
    content: "";
    width: 0.75rem;
    height: 0.75rem;
    flex: 0 0 auto;
    border: 2px solid var(--ink);
    background: var(--accent-yellow);
    transform: rotate(-5deg);
  }

  @media (max-width: 620px) {
    .project-gallery {
      margin-block: 1.8em 2.5em;
      padding: 0.5rem;
      box-shadow: var(--shadow-sm);
      transform: none;
    }

    .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.55rem;
    }

    figcaption {
      margin: 0.6rem 0.15rem 0.05rem;
      font-size: 0.72rem;
    }
  }
</style>
