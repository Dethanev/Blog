---
interface Props {
  scope: "post" | "site";
  viewKey?: string;
  tone?: "inline" | "footer";
}

const {
  scope,
  viewKey = scope,
  tone = "inline",
} = Astro.props;
const accessibleLabel = scope === "site" ? "此裝置網站瀏覽次數" : "此裝置文章瀏覽次數";
---

<span
  class:list={["view-counter", `view-counter-${tone}`]}
  data-view-counter
  data-view-scope={scope}
  data-view-key={viewKey}
  aria-label={accessibleLabel}
  title="只計算這台裝置的瀏覽次數，不是全站統計"
>
  <span class="view-mark" aria-hidden="true">◉</span>
  <span class="view-count" data-view-count>--</span>
</span>

<style>
  .view-counter {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    width: fit-content;
    font-family: var(--font-mono);
    font-weight: 800;
    line-height: 1;
    white-space: nowrap;
    vertical-align: middle;
  }
  .view-counter-inline {
    color: inherit;
  }
  .view-counter-footer {
    box-sizing: border-box;
    width: var(--footer-badge-width, 22rem);
    justify-content: center;
    max-width: calc(100vw - 3rem);
    border: 3px solid var(--bg);
    background: var(--accent-lime);
    color: var(--text-on-lime);
    min-height: 4.5rem;
    padding: 0.9rem 1.4rem;
    gap: 0.7rem;
    font-size: clamp(1.1rem, 2vw, 1.55rem);
    border-width: 6px;
  }
  :global(.dark) .view-counter-footer {
    border-color: var(--ink);
  }
  .view-mark {
    display: inline-block;
    width: 1rem;
    height: 1rem;
    border: 2px solid var(--text-on-pink);
    border-radius: 999px;
    background: var(--accent-pink);
    box-shadow: 1.5px 1.5px 0 0 var(--text-on-pink);
    color: transparent;
    font-size: 0;
  }
  .view-count {
    min-width: 2ch;
    font-variant-numeric: tabular-nums;
  }
  .view-counter-footer .view-count {
    font-size: 1.05em;
  }
</style>
