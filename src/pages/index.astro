---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Hero from "~/components/Hero.astro";
import PostCard from "~/components/PostCard.astro";
import Marquee from "~/components/Marquee.astro";
import Sticker from "~/components/Sticker.astro";
import { getCollection } from "astro:content";
import { sortPostsNewestFirst } from "~/lib/utils";

const posts = sortPostsNewestFirst(await getCollection("posts", ({ data }) => !data.draft)).slice(0, 3);

const stack = [
  { name: "Flutter", note: "App 主力，UI 跟流程都在這裡磨" },
  { name: "FastAPI", note: "後端 API，先能跑再慢慢補硬" },
  { name: "Supabase", note: "Postgres + auth\n自架時順便練維運" },
  { name: "Docker", note: "服務拆開，不要全部塞同一台" },
  { name: "Proxmox", note: "家裡小機房，VM 跟容器都丟上去" },
  { name: "Cloudflare", note: "Tunnel 出門，少開一些奇怪的洞" },
  { name: "Astro", note: "這個 blog，靜態為主動的自己加" },
  { name: "Ollama", note: "本地 LLM 實驗，Gemma 先玩起來" },
];

const projects = [
  { num: "01", name: "LinkPet", tagline: "比賽專案留下的合作練習\n學會把想法、分工和文件同步清楚。", tag: "Teamwork", color: "pink", href: "/blog/2026-04-18-linkpet-ar-ai-companion" },
  { num: "02", name: "Tap2Go", tagline: "暑假狂練 Flutter UI 的成果\n算是有收尾的那種。", tag: "Done", color: "yellow", href: "/blog/2026-06-04-projects-that-broke" },
  { num: "03", name: "this blog", tagline: "你正在看的東西\nAstro + Tailwind v4 + GSAP。", tag: "Live", color: "lime", href: "/blog/2026-05-10-astro-6-tailwind-v4" },
  { num: "04", name: "DriveWorth", tagline: "汽車維護計算 App 原型\n不是不能做，是我低估資料的重要性。", tag: "Lessons", color: "violet", href: "/blog/2026-02-11-driveworth-app" },
  { num: "05", name: "HawkGuard", tagline: "預防詐騙 App 原型\n後來發現 Whoscall 已經在前面很遠。", tag: "Archived", color: "paper", href: "/blog/2025-12-03-hawkguard-app" },
] as const;

const marqueeItems = [
  "BUILDING NOW",
  "寫點 Code",
  "做些 App",
  "做些 Web",
  "刻點 UI",
  "串串 API",
  "架個 Server",
  "修修 Bug",
  "踩坑中",
  "慢慢上線",
];
---

<BaseLayout>
  <Hero />

  <!-- About preview -->
  <section class="about-preview">
    <div class="ap-grid">
      <div class="ap-left">
        <p class="quote">
          <span class="q-mark" aria-hidden="true">"</span>
          做東西、做壞東西，然後把教訓留下來。
        </p>
      </div>
      <div class="ap-right">
        <p class="lede">
          Hi，我是 Dethanev。私校資工系學生，成績維持在系排前 5%。
          平常寫 App、做後端、折騰自架服務；這裡放 dev 筆記、專案紀錄，還有一些踩坑後才懂的事。
        </p>
        <a href="/about" class="cta brutal-border-thick brutal-shadow brutal-hover">
          → 更多關於我
        </a>
      </div>
    </div>
  </section>

  <!-- Latest posts -->
  <section class="section">
    <header class="section-head">
      <h2 class="section-title latest-posts-title">
        <span>LATEST</span><span>POSTS</span>
      </h2>
      <a href="/blog" class="see-all">全部文章 →</a>
    </header>

    <div class="posts-grid">
      {posts.map((p, i) => (
        <PostCard
          href={`/blog/${p.id}`}
          title={p.data.title}
          description={p.data.description}
          date={p.data.date}
          tags={p.data.tags}
          variant={p.data.variant}
          index={i}
          tilt={0}
        />
      ))}
    </div>
  </section>

  <Marquee items={marqueeItems} variant="ink" speed={70} />

  <!-- Horizontal showcase (pin + scroll) -->
  <section class="h-showcase" data-h-scroll aria-label="做過的東西">
    <div class="h-track" data-h-track>
      <div class="h-intro">
        <div class="h-heading">
          <h2 class="h-title">
            <span class="line">SELECTED</span>
            <span class="line accent">WORK.</span>
          </h2>
          <p class="h-subtitle">精選作品 · 做過的東西</p>
        </div>
        <div class="h-cue">
          <span class="cue-down">↓ scroll</span>
          <span class="cue-eq">=</span>
          <span class="cue-right">→ slide</span>
          <span class="cue-touch">← 左右滑動 →</span>
        </div>
      </div>

      {projects.map((p) => (
        <a
          href={p.href}
          class:list={["h-card brutal-border-thick brutal-shadow", `card-${p.color}`]}
          aria-label={`閱讀 ${p.name} 相關文章`}
        >
          <span class="h-num">{p.num}</span>
          <div class="h-card-body">
            <h3 class="h-name">{p.name}</h3>
            <p class="h-tagline">{p.tagline}</p>
          </div>
          <div class="h-card-foot">
            <span class="h-tag">{p.tag}</span>
            <span class="h-arrow" aria-hidden="true">→</span>
          </div>
        </a>
      ))}

      <a href="https://github.com/Dethanev" target="_blank" rel="noopener" class="h-end brutal-border-thick brutal-shadow brutal-hover">
        <span class="end-arrow">→</span>
        <span class="end-text">看更多 on GitHub</span>
      </a>
    </div>

    <div class="h-progress-wrap" aria-hidden="true">
      <span class="h-progress-label">/ 橫向進度</span>
      <div class="h-progress-bar">
        <div class="h-progress-fill" data-h-progress></div>
      </div>
    </div>
  </section>

  <!-- Stack -->
  <section class="section">
    <header class="section-head">
      <h2 class="section-title">STACK &amp; TOOLS</h2>
      <Sticker text="✦ 隨時換" color="pink" rotate={0} size="sm" />
    </header>

    <div class="stack-grid" data-stagger>
      {stack.map((s) => (
        <div class="stack-item brutal-border-thick brutal-shadow-sm" data-stagger-item>
          <div class="stack-name">{s.name}</div>
          <div class="stack-note">{s.note}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA strip -->
  <section class="cta-strip">
    <a href="/now" class="cta-inner brutal-border-thick brutal-shadow-lg" aria-label="查看我的近況">
      <p class="cta-text">
        想知道我現在在幹嘛？<br/>
        <span class="cta-link"><span class="cta-arrow" aria-hidden="true">→</span> 看看 /now</span>
      </p>
      <span class="live-badge" aria-hidden="true">
        <span class="live-dot"></span>
        LIVE&nbsp; 正在寫 Blog
      </span>
    </a>
  </section>
</BaseLayout>

<style>
  .about-preview {
    max-width: 1100px;
    margin: 5rem auto;
    padding: 0 1.5rem;
  }
  .ap-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .quote {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.8rem, 3.6vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    position: relative;
  }
  .q-mark {
    color: var(--accent-pink);
    font-size: 2em;
    line-height: 0;
    margin-right: 0.1em;
  }
  .lede {
    font-size: 1.05rem;
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }
  .cta {
    display: inline-block;
    background: var(--accent-yellow);
    color: var(--text-on-yellow);
    text-decoration: none;
    padding: 0.7rem 1.2rem;
    font-family: var(--font-display);
    font-weight: 800;
    transform: rotate(0deg);
  }

  .section {
    max-width: 1100px;
    margin: 6rem auto;
    padding: 0 1.5rem;
  }
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 2.5rem;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .section-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.8rem, 4vw, 3rem);
    letter-spacing: 0.04em;
    line-height: 1;
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
  .latest-posts-title {
    column-gap: 1em;
  }
  .see-all {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 3px solid var(--accent-pink);
    padding-bottom: 2px;
  }
  .see-all:hover { background: var(--accent-yellow); color: var(--text-on-yellow); }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .posts-grid :global(.post-card) {
    box-sizing: border-box;
    height: 100%;
  }
  .posts-grid :global(.card-link) {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .posts-grid :global(.tags) {
    margin-top: auto;
  }

  .stack-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 1fr;
    column-gap: 1rem;
    row-gap: 1.5rem;
  }
  .stack-item {
    background: var(--paper);
    padding: 1rem 1.1rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .stack-item:hover {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 0 var(--shadow-color);
  }
  .stack-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    margin-bottom: 0.2rem;
  }
  .stack-note {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
    line-height: 1.4;
    white-space: pre-line;
  }

  /* Horizontal showcase */
  .h-showcase {
    position: relative;
    height: 100vh;
    overflow: hidden;
    background: var(--paper);
    border-block: 4px solid var(--ink);
    margin-block: 5rem 0;
  }
  .h-track {
    display: flex;
    align-items: center;
    height: 100%;
    width: max-content;
    gap: 2.5rem;
    padding-inline: 6rem;
    will-change: transform;
  }
  .h-intro {
    flex: 0 0 auto;
    width: 480px;
    height: 62vh;
    max-height: 480px;
    padding: 1.7rem 3.25rem 1.7rem 0;
    border-right: 4px solid var(--ink);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2.5rem;
    align-self: center;
  }
  .h-heading {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .h-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(3.25rem, 4.1vw, 3.65rem);
    line-height: 0.88;
    letter-spacing: -0.03em;
    margin: 0;
    transform: rotate(1deg);
  }
  .h-title .line {
    display: block;
    width: 100%;
    text-align: center;
    white-space: nowrap;
  }
  .h-title .accent {
    background: var(--accent-pink);
    color: var(--text-on-pink);
    border: 4px solid var(--ink);
    box-shadow: 6px 6px 0 0 var(--shadow-color);
    padding: 0.08em 0.15em;
    box-sizing: border-box;
    margin-top: 0.1em;
  }
  .h-subtitle {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-align: center;
  }
  .h-cue {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border: 3px solid var(--ink);
    background: var(--accent-yellow);
    color: var(--text-on-yellow);
    padding: 0.45rem 0.9rem;
    align-self: stretch;
    transform: rotate(1deg);
  }
  .h-cue .cue-eq { opacity: 0.5; }
  .h-cue .cue-touch { display: none; }

  .h-card {
    flex: 0 0 auto;
    width: 360px;
    height: 62vh;
    max-height: 480px;
    background: var(--paper);
    padding: 1.6rem 1.7rem 1.7rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transform: rotate(1deg);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
    position: relative;
    color: var(--ink);
    text-decoration: none;
  }
  .h-card:hover {
    transform: rotate(0deg) translate(-4px, -4px);
    box-shadow: 10px 10px 0 0 var(--shadow-color);
    z-index: 2;
  }
  .h-card.card-paper { background: var(--paper); }
  .h-card.card-pink { background: var(--accent-pink); color: var(--text-on-pink); border-color: var(--ink); }
  .h-card.card-yellow { background: var(--accent-yellow); color: var(--text-on-yellow); border-color: var(--ink); }
  .h-card.card-lime { background: var(--accent-lime); color: var(--text-on-lime); border-color: var(--ink); }
  .h-card.card-violet { background: var(--accent-violet); color: var(--text-on-violet); border-color: var(--ink); }

  .h-num {
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    background: var(--ink);
    color: var(--bg);
    padding: 0.25em 0.6em;
    align-self: flex-start;
    border: 2px solid var(--ink);
  }
  :global(.dark) .h-num { background: var(--accent-yellow); color: var(--text-on-yellow); border-color: var(--ink); }
  .h-card-body { flex: 1; display: flex; flex-direction: column; justify-content: center; }
  .h-name {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2rem, 3.2vw, 2.6rem);
    line-height: 1;
    letter-spacing: -0.03em;
    margin-bottom: 0.8rem;
  }
  .h-tagline {
    font-size: 0.95rem;
    line-height: 1.5;
    opacity: 0.9;
    white-space: pre-line;
  }
  .h-card-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 2px dashed color-mix(in oklab, var(--ink) 30%, transparent);
    padding-top: 0.9rem;
  }
  .card-violet .h-card-foot { border-color: color-mix(in oklab, currentColor 35%, transparent); }
  .h-tag {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border: 2px solid currentColor;
    padding: 0.15em 0.55em;
  }
  .h-arrow {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.6rem;
    line-height: 1;
  }

  .h-end {
    flex: 0 0 auto;
    width: 280px;
    height: 62vh;
    max-height: 480px;
    background: var(--ink);
    color: var(--bg);
    text-decoration: none;
    padding: 1.6rem 1.7rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    font-family: var(--font-display);
    font-weight: 900;
  }
  :global(.dark) .h-end { background: var(--accent-yellow); color: var(--text-on-yellow); }
  .h-end .end-arrow { font-size: 4rem; line-height: 1; }
  .h-end .end-text { font-size: 1.4rem; line-height: 1.2; letter-spacing: -0.02em; }

  .h-progress-wrap {
    position: absolute;
    bottom: 1.2rem;
    left: 2rem;
    right: 2rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    z-index: 5;
  }
  .h-progress-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--muted);
    letter-spacing: 0.08em;
    white-space: nowrap;
  }
  .h-progress-bar {
    flex: 1;
    height: 6px;
    border: 2px solid var(--ink);
    background: var(--paper);
  }
  .h-progress-fill {
    height: 100%;
    background: var(--accent-pink);
    transform-origin: left center;
    transform: scaleX(0);
  }
  :global(.dark) .h-progress-fill { background: var(--accent-yellow); }

  @media (max-width: 720px) {
    .h-showcase {
      height: 100dvh;
    }
    .h-track {
      padding-inline: 1.5rem;
      gap: 2.5rem;
    }
    .h-intro {
      width: 80vw;
      height: 60vh;
      padding: 1.5rem 1.5rem 1.5rem 0;
      border-right: none;
      border-bottom: 4px solid var(--ink);
      gap: 2.25rem;
    }
    .h-title {
      font-size: clamp(2.25rem, 9.5vw, 3rem);
    }
    .h-card { width: 78vw; height: 60vh; }
    .h-end {
      width: 60vw;
      height: 60vh;
    }
    .h-progress-wrap { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .h-showcase {
      height: auto;
      overflow-x: auto;
      overflow-y: hidden;
      padding-block: 2rem;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .h-showcase::-webkit-scrollbar { display: none; }
    .h-track {
      transform: none !important;
      padding-inline: 1.5rem;
      gap: 1rem;
      width: max-content;
    }
    .h-intro {
      width: 80vw;
      height: auto;
      padding: 1.5rem 1.5rem 1.5rem 0;
      border-right: none;
      border-bottom: 4px solid var(--ink);
      gap: 2.25rem;
      scroll-snap-align: start;
    }
    .h-cue .cue-down,
    .h-cue .cue-eq,
    .h-cue .cue-right { display: none; }
    .h-cue .cue-touch { display: inline; }
    .h-card { width: 78vw; height: 60vh; scroll-snap-align: start; }
    .h-end { width: 60vw; height: 60vh; scroll-snap-align: start; }
    .h-progress-wrap { display: none; }
  }

  .cta-strip {
    max-width: 1100px;
    margin: 5rem auto 7rem;
    padding: 0 1.5rem;
  }
  .cta-inner {
    background: var(--accent-violet);
    color: var(--text-on-violet);
    padding: 2rem 2.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    transform: rotate(0deg);
    text-decoration: none;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .cta-inner:hover,
  .cta-inner:focus-visible {
    transform: translate(-4px, -4px);
    box-shadow: 12px 12px 0 0 var(--shadow-color);
  }
  .cta-inner:active {
    transform: translate(2px, 2px);
    box-shadow: 4px 4px 0 0 var(--shadow-color);
  }
  .cta-inner:focus-visible {
    outline: 4px solid var(--focus-ring);
    outline-offset: 4px;
  }
  .cta-text {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.2rem, 2.4vw, 1.8rem);
    line-height: 1.25;
  }
  .cta-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 4px;
    text-decoration-color: var(--accent-yellow);
    text-underline-offset: 4px;
  }
  .cta-arrow {
    display: inline-block;
    transition: transform 0.18s ease;
  }
  .cta-inner:hover .cta-arrow,
  .cta-inner:focus-visible .cta-arrow { transform: translateX(8px); }
  .live-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    flex: 0 0 auto;
    padding: 0.5rem 1rem;
    border: 3px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    box-shadow: 4px 4px 0 0 var(--shadow-color);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.01em;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .cta-inner:hover .live-badge,
  .cta-inner:focus-visible .live-badge {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 0 var(--shadow-color);
  }
  .cta-inner:active .live-badge {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 0 var(--shadow-color);
  }
  .live-dot {
    width: 0.6rem;
    height: 0.6rem;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--accent-pink);
    animation: live-pulse 1.8s ease-in-out infinite;
  }
  @keyframes live-pulse {
    0%, 100% { transform: scale(0.8); opacity: 0.55; }
    50% { transform: scale(1.15); opacity: 1; }
  }

  @media (max-width: 720px) {
    .ap-grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .posts-grid { grid-template-columns: 1fr; }
    .stack-grid { grid-template-columns: repeat(2, 1fr); }
    .cta-inner { flex-direction: column; text-align: center; }
  }
</style>
