---
import BaseLayout from "~/layouts/BaseLayout.astro";
import PostCard from "~/components/PostCard.astro";
import { getCollection } from "astro:content";
import { sortPostsNewestFirst } from "~/lib/utils";

const posts = sortPostsNewestFirst(await getCollection("posts", ({ data }) => !data.draft));

const categories = [
  { id: "project", label: "專案實作", description: "作品、產品與踩坑紀錄", mark: "↗", color: "pink" },
  { id: "tech", label: "技術筆記", description: "開發工具與實作方法", mark: "{ }", color: "yellow" },
  { id: "design", label: "設計探索", description: "介面、動態與視覺觀察", mark: "✦", color: "lime" },
  { id: "meta", label: "站務隨筆", description: "關於這個網站的近況", mark: "…", color: "violet" },
] as const;

type CategoryId = (typeof categories)[number]["id"];

function getPostCategory(tags: string[]): CategoryId {
  if (tags.includes("project")) return "project";
  if (tags.some((tag) => ["design", "ui"].includes(tag))) return "design";
  if (tags.includes("meta")) return "meta";
  return "tech";
}

const categoryCounts = Object.fromEntries(
  categories.map(({ id }) => [id, posts.filter((post) => getPostCategory(post.data.tags) === id).length]),
);
---

<BaseLayout title="文章" description="Dethanev 開發室的文章列表，整理 Dethanev 的 App、Web、後端服務、自架系統、作品集與 side project 開發筆記。">
  <section class="blog-head">
    <div class="head-inner">
      <h1 class="sr-only">所有文章</h1>

      <div class="category-grid" aria-label="文章分類">
        <button type="button" class="category-card category-all is-active" data-category-filter="all" aria-pressed="true">
          <span class="category-top"><span class="category-mark">ALL</span><strong>{posts.length}</strong></span>
          <span class="category-label">全部文章</span>
          <span class="category-description">一次看看所有內容</span>
        </button>
        {categories.map((category) => (
          <button
            type="button"
            class:list={["category-card", `category-${category.color}`]}
            data-category-filter={category.id}
            aria-pressed="false"
          >
            <span class="category-top"><span class="category-mark">{category.mark}</span><strong>{categoryCounts[category.id]}</strong></span>
            <span class="category-label">{category.label}</span>
            <span class="category-description">{category.description}</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <section class="posts-section">
    <div class="posts-list">
      {posts.map((p, i) => (
        <PostCard
          href={`/blog/${p.id}`}
          title={p.data.title}
          description={p.data.description}
          date={p.data.date}
          tags={p.data.tags}
          category={getPostCategory(p.data.tags)}
          variant={p.data.variant}
          index={i}
          tilt={1.5}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .blog-head {
    max-width: 1100px;
    margin: 3rem auto 4rem;
    padding: 0 1.5rem;
  }
  .head-inner {
    border-bottom: 4px solid var(--ink);
    padding-bottom: 2rem;
  }
  .category-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .category-card {
    min-width: 0;
    padding: 0.8rem 0.85rem 0.9rem;
    border: 3px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    box-shadow: 4px 4px 0 var(--shadow-color);
    text-align: left;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .category-card:hover {
    transform: translate(-2px, -2px) rotate(-1deg);
    box-shadow: 7px 7px 0 var(--shadow-color);
  }
  .category-card:active {
    transform: translate(3px, 3px);
    box-shadow: 1px 1px 0 var(--shadow-color);
  }
  .category-card:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 4px;
  }
  .category-card.is-active {
    transform: translate(3px, 3px);
    box-shadow: 1px 1px 0 var(--shadow-color);
  }
  .category-all { background: var(--paper); }
  .category-pink { background: var(--accent-pink); color: var(--text-on-pink); border-color: var(--ink); }
  .category-yellow { background: var(--accent-yellow); color: var(--text-on-yellow); border-color: var(--ink); }
  .category-lime { background: var(--accent-lime); color: var(--text-on-lime); border-color: var(--ink); }
  .category-violet { background: var(--accent-violet); color: var(--text-on-violet); border-color: var(--ink); }
  .category-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    margin-bottom: 0.65rem;
  }
  .category-mark { font-weight: 900; }
  .category-label {
    display: block;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 900;
    line-height: 1.2;
  }
  .category-description {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.72rem;
    line-height: 1.35;
    opacity: 0.78;
  }

  .posts-section {
    max-width: 1100px;
    margin: 0 auto 6rem;
    padding: 0 1.5rem;
  }
  .posts-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.8rem;
  }

  @media (max-width: 720px) {
    .blog-head { margin-top: 2rem; }
    .category-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .category-card:first-child { grid-column: 1 / -1; }
    .posts-list { grid-template-columns: 1fr; }
  }
</style>
