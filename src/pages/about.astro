---
import BaseLayout from "~/layouts/BaseLayout.astro";

const wakatimeProfile = "https://wakatime.com/@Dethanev";
const wakatimeBadge = "https://wakatime.com/badge/user/befca022-bf1e-4d10-a1fe-ce2001dfc840.svg?style=for-the-badge";

const factoids = [
  { k: "現居", v: "台灣" },
  { k: "身份", v: "資工大二生" },
  { k: "角色", v: "Developer / Server Admin" },
  { k: "目前", v: "Building Blog" },
  { k: "主線", v: "App / Web /Server" },
  { k: "環境", v: "macOS / Linux" },
];

const focusAreas = [
  {
    title: "App 與產品實作",
    body: "主要用 Flutter 做跨平台 App，也持續關注 Swift、ARKit、RealityKit 與互動體驗。比起只把畫面刻完，我更在意流程能不能真的被使用。",
  },
  {
    title: "後端與資料",
    body: "偏好 FastAPI、PostgreSQL、Supabase 這類清楚、可維護的組合，也碰過 Node.js、MySQL、SQLite。資料模型、API 邊界和型別安全，是我現在很重視的部分。",
  },
  {
    title: "自架與維運",
    body: "會折騰 Docker、Proxmox、Nginx、Cloudflare / Zero Trust、Prometheus、Grafana，以及 Linux / macOS 開發環境。目的不是堆工具，而是理解系統怎麼跑起來。",
  },
];

const certifications = [
  { name: "汽車修護乙級", category: "技術士證照", color: "auto", date: "2024-02-21", href: "https://www.1111edu.com.tw/licence_content.php?autono=898" },
  { name: "汽車修護丙級", category: "技術士證照", color: "auto", date: "2023-06-26", href: "https://www.1111edu.com.tw/licence_content.php?autono=899" },
  { name: "培力英檢", category: "語言能力", color: "language", date: "2025-07-01", href: "https://bestep.tw/About/page?id=f5bab1a4153247f6abd8ae0fad362643" },
  { name: "HITCON 台灣駭客", category: "資安社群", color: "language", date: "2025-08-15", href: "https://hitcon.org/2025/zh-TW/" },
  { name: "ITS Java", category: "程式與資訊", color: "it", date: "2026-05-20", href: "https://www.gotop.com.tw/certifications/itemdetails.aspx?subid=230" },
  { name: "ITS Database", category: "程式與資訊", color: "it", date: "2026-06-10", href: "https://www.gotop.com.tw/certifications/itemdetails.aspx?subid=226" },
  { name: "高斯數學競賽｜優等", category: "數學競賽", color: "math", date: "2025-12-03", href: "https://zh.wikipedia.org/zh-tw/%E5%8D%A1%E7%88%BE%C2%B7%E5%BC%97%E9%87%8C%E5%BE%B7%E9%87%8C%E5%B8%8C%C2%B7%E9%AB%98%E6%96%AF" },
  { name: "高斯數學競賽｜甲等", category: "數學競賽", color: "math", date: "2025-06-04", href: "https://zh.wikipedia.org/zh-tw/%E5%8D%A1%E7%88%BE%C2%B7%E5%BC%97%E9%87%8C%E5%BE%B7%E9%87%8C%E5%B8%8C%C2%B7%E9%AB%98%E6%96%AF" },
];

const mosCertifications = [
  { name: "Microsoft Office Specialist Associate 2019", date: "2025-11-18", href: "https://learn.microsoft.com/zh-tw/credentials/certifications/microsoft-office-specialist-associate-2019/" },
  { name: "Microsoft Office Specialist Expert 2019", date: "2026-05-08", href: "https://learn.microsoft.com/zh-tw/credentials/certifications/microsoft-office-specialist-expert-2019/" },
  { name: "Excel 2019 Associate", date: "2025-11-11", href: "https://learn.microsoft.com/zh-tw/credentials/certifications/mos-excel-2019/?practice-assessment-type=certification" },
  { name: "Excel 2019 Expert", date: "2026-05-08", href: "https://learn.microsoft.com/zh-tw/credentials/certifications/mos-excel-expert-2019/?practice-assessment-type=certification" },
  { name: "Word 2019 Associate", date: "2025-11-18", href: "https://learn.microsoft.com/zh-tw/credentials/certifications/mos-word-2019/?practice-assessment-type=certification" },
  { name: "Word 2019 Expert", date: "2026-05-08", href: "https://learn.microsoft.com/zh-tw/credentials/certifications/mos-word-expert-2019/?practice-assessment-type=certification" },
  { name: "PowerPoint 2019 Associate", date: "2025-11-11", href: "https://learn.microsoft.com/zh-tw/credentials/certifications/mos-powerpoint-2019/?practice-assessment-type=certification" },
  { name: "PowerPoint 2016", date: "2025-05-19", href: "https://learn.microsoft.com/zh-tw/credentials/certifications/mos-powerpoint-2016/?practice-assessment-type=certification" },
