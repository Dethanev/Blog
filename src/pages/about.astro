---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Sticker from "~/components/Sticker.astro";

const factoids = [
  { k: "現居", v: "台灣" },
  { k: "身份", v: "資工學生" },
  { k: "成績", v: "系排前 5%" },
  { k: "主線", v: "App / backend" },
  { k: "現在", v: "LinkPet" },
  { k: "環境", v: "Mac + Linux" },
];
---

<BaseLayout title="關於" description="關於 Dethanev 的二三事">
  <section class="about">
    <div class="hero-block">
      <h1 class="big-title">
        <span class="line">關於</span>
        <span class="line accent">DETHANEV.</span>
      </h1>
      <p class="lede">
        我是 Dethanev。私校資工系學生，主要做 App、後端服務跟自架系統。
        這個站放我正在做的東西、寫壞的東西，還有下一次不要再踩的坑。
      </p>
      <div class="stickers">
        <Sticker text="Computer" color="pink" rotate={-5} />
        <Sticker text="Science" color="violet" rotate={3} />
        <Sticker text="Student" color="yellow" rotate={-2} />
      </div>
    </div>

    <div class="facts brutal-border-thick brutal-shadow" data-stagger>
      <h2 class="block-title">
        <span class="badge">facts</span>
      </h2>
      <dl class="fact-list">
        {factoids.map((f) => (
          <div class="fact-row" data-stagger-item>
            <dt>{f.k}</dt>
            <dd>{f.v}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="text-block">
      <h2 class="block-title">
        <span class="badge yellow">background</span>
      </h2>
      <p>
        我是一名私校資工系學生，成績維持在系排前 5%。平常的重心放在實作：
        Flutter App、FastAPI 後端、Supabase / PostgreSQL，以及 Docker、Proxmox、Cloudflare Tunnels 這類自架服務。
      </p>
      <p>
        我也有汽車修護乙級與丙級技術士證照，但這不是這個網站的主線。
        它比較像一段背景：證明我不是只會坐在電腦前，也曾經真的拆過東西，只是現在拆的是 bug。
      </p>
    </div>

    <div class="text-block">
      <h2 class="block-title">
        <span class="badge violet">projects</span>
      </h2>
      <ul class="list">
        <li><strong>LinkPet</strong> — 目前還在推進的主專案，先做出來再講漂亮話</li>
        <li><strong>Tap2Go</strong> — 已完成的 Flutter UI 練習專案，暑假有認真過的證據</li>
        <li><strong>DriveWorth</strong> — 已放棄，最大的教訓是不要低估資料的重要性</li>
        <li><strong>Hawk Guardian</strong> — 已放棄，市場判斷跟資料問題都沒有想夠</li>
      </ul>
    </div>

    <div class="text-block">
      <h2 class="block-title">
        <span class="badge pink">what's here</span>
      </h2>
      <ul class="list">
        <li><strong>/blog</strong> — dev 筆記、專案反思、工具踩坑</li>
        <li><strong>/now</strong> — 我現在在幹嘛，不是履歷頁</li>
        <li><strong>/about</strong> — 公開版自介，也就是你現在看的東西</li>
        <li><strong>彩蛋</strong> — 點 5 下 logo，看網站是不是有偷偷藏東西</li>
      </ul>
    </div>

    <div class="text-block">
      <h2 class="block-title">
        <span class="badge yellow">how to reach</span>
      </h2>
      <p>
        最快的方式是到 <a href="https://github.com/Dethanev/Blog/discussions" target="_blank" rel="noopener">GitHub Discussions</a> 留言，公開討論或私訊都行。
        GitHub 跟 Discord 也都會看，但回覆速度看當週狀況。
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    max-width: 800px;
    margin: 3rem auto 6rem;
    padding: 0 1.5rem;
    box-sizing: border-box;
    display: grid;
    gap: 3rem;
  }
  .hero-block { margin-bottom: 1rem; }
  .about > * { min-width: 0; }
  .big-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(3rem, 8vw, 5.5rem);
    line-height: 0.92;
    letter-spacing: -0.04em;
    margin-bottom: 1.2rem;
  }
  .big-title .line { display: block; }
  .big-title .accent {
    background: var(--accent-2);
    color: var(--ink);
    border: 4px solid var(--ink);
    box-shadow: 8px 8px 0 0 var(--ink);
    padding: 0 0.15em;
    display: inline-block;
    transform: rotate(-1deg);
    margin-top: 0.1em;
  }
  :global(.dark) .big-title .accent { box-shadow: 8px 8px 0 0 var(--accent-1); }
  .lede {
    font-size: 1.1rem;
    line-height: 1.65;
    margin-bottom: 1.5rem;
    max-width: 50ch;
  }
  .stickers { display: flex; flex-wrap: wrap; gap: 0.8rem; }

  .facts {
    background: var(--paper);
    padding: 1.6rem 1.8rem;
    transform: rotate(-0.5deg);
  }
  .facts { box-sizing: border-box; }
  .block-title { margin-bottom: 1.2rem; }
  .badge {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 0.85rem;
    background: var(--accent-1);
    color: var(--ink);
    border: 3px solid var(--ink);
    padding: 0.2em 0.7em;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    transform: rotate(-2deg);
  }
  .badge.yellow { background: var(--accent-2); }
  .badge.violet { background: var(--accent-4); color: white; }
  :global(.dark) .badge.violet { color: var(--ink); }
  .badge.pink { background: var(--accent-1); }

  .fact-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.6rem 2rem;
    margin: 0;
  }
  .fact-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 0.5rem;
    border-bottom: 2px dotted color-mix(in oklab, var(--ink) 25%, transparent);
  }
  .fact-row dt {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .fact-row dd {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    margin: 0;
  }

  .text-block {
    font-size: 1.05rem;
    line-height: 1.7;
  }
  .text-block p { margin-block: 0.8em; }
  .text-block a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-decoration-color: var(--accent-1);
    text-underline-offset: 3px;
  }
  .text-block a:hover { background: var(--accent-2); }

  .list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .list li { position: relative; padding-left: 1.5em; }
  .list li::before {
    content: "▸";
    position: absolute;
    left: 0;
    color: var(--accent-1);
    font-weight: 900;
  }
  .list strong {
    font-family: var(--font-mono);
    background: var(--accent-2);
    border: 2px solid var(--ink);
    padding: 0.05em 0.4em;
    font-size: 0.85em;
    font-weight: 700;
  }

  @media (max-width: 640px) {
    .big-title { font-size: clamp(2.4rem, 12vw, 5.5rem); }
    .big-title .accent { box-sizing: border-box; max-width: 100%; }
    .fact-list { grid-template-columns: 1fr; }
  }
</style>
