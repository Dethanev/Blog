---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Sticker from "~/components/Sticker.astro";
import { formatDate } from "~/lib/utils";

const updated = new Date("2026-06-19");

const items = [
  { color: "pink", title: "目前主線", body: "先把這個 Blog 做好。持續整理內容、版面與閱讀體驗，讓它真正成為能長期累積的作品。" },
  { color: "yellow", title: "作品整理", body: "把做過的專案整理成更完整的作品紀錄，說清楚想法、技術選擇，以及過程中學到的事。" },
  { color: "lime", title: "正在寫", body: "把做過的專案、踩過的坑與技術筆記整理成文章，不只留下結果，也說清楚過程和判斷。" },
  { color: "violet", title: "正在調整", body: "繼續改善 Blog 的首頁、文章內容與互動細節，讓作品資訊更一致，也更容易閱讀。" },
  { color: "pink", title: "最近完成", body: "通過 ITS Java 與 ITS Database 認證，替程式設計與資料庫基礎留下一個階段性的學習紀錄。" },
  { color: "yellow", title: "接下來", body: "暫時不急著開新的大專案。先把 Blog 和既有內容收尾，再決定下一個真正值得投入的方向。" },
];
---

<BaseLayout title="近況" description="我現在在幹嘛的即時頁面">
  <section class="now">
    <header class="now-head">
      <h1 class="title">
        <span class="line">/</span>
        <span class="line now-word">NOW</span>
      </h1>
      <p class="lede">
        現在先把 Blog 做好，把做過的事與學到的東西整理成能持續累積的內容。
      </p>
      <p class="updated">
        <span class="updated-label">last updated</span>
        <Sticker text={formatDate(updated)} color="lime" rotate={0} size="sm" />
      </p>
    </header>

    <div class="grid" data-stagger>
      {items.map((it) => (
        <div class:list={["card", "brutal-border-thick", "brutal-shadow", `card-${it.color}`]} data-stagger-item>
          <h3 class="card-title">{it.title}</h3>
          <p class="card-body">{it.body}</p>
        </div>
      ))}
    </div>

    <p class="footnote">
      這頁我有想到就改一下。如果距離 last updated 已經一年了，請假裝沒看到。
    </p>
  </section>
</BaseLayout>

<style>
  .now {
    max-width: 1000px;
    margin: 3rem auto 6rem;
    padding: 0 1.5rem;
  }
  .now-head { margin-bottom: 3rem; }
  .title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(4rem, 14vw, 10rem);
    line-height: 0.88;
    letter-spacing: -0.05em;
    margin-bottom: 1.2rem;
    display: flex;
    align-items: baseline;
    gap: 0.1em;
  }
  .title .line { display: inline-block; }
  .now-word {
    background: var(--accent-1);
    color: var(--ink);
    border: 5px solid var(--ink);
    box-shadow: 10px 10px 0 0 var(--ink);
    padding: 0 0.1em;
    transform: rotate(0deg);
  }
  :global(.dark) .now-word { box-shadow: 10px 10px 0 0 var(--accent-2); }
  .lede {
    font-size: 1.05rem;
    line-height: 1.65;
    margin-bottom: 1.2rem;
    max-width: 55ch;
  }
  .lede a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-decoration-color: var(--accent-2);
  }
  .updated {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .updated-label {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-bottom: 3rem;
  }
  .card {
    padding: 1.2rem 1.4rem 1.4rem;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 9px 9px 0 0 var(--ink);
  }
  :global(.dark) .card:hover { box-shadow: 9px 9px 0 0 var(--accent-2); }
  .card-pink { background: var(--accent-1); }
  .card-yellow { background: var(--accent-2); }
  .card-lime { background: var(--accent-3); }
  .card-violet { background: var(--accent-4); color: white; }
  :global(.dark) .card-violet { color: var(--ink); }
  .card-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }
  .card-body {
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .footnote {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--muted);
    text-align: center;
    max-width: 40ch;
    margin: 0 auto;
  }

  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
